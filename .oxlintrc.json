{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "apps/code/.tanstack/**",
    "apps/code/.output/**",
    "apps/code/convex/_generated/**",
    "apps/code/src/routeTree.gen.ts",
    "apps/design/src/routeTree.gen.ts",
    "artifacts/**",
    "emulator/**",
    "apps/brain/public/**"
  ]
}
