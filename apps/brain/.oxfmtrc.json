{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/shadcn.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "public/**",
