{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "public/**",
    "node_modules/**",
    "dist/**",
    "dist-ssr/**",
    "coverage/**"
  ]
}
