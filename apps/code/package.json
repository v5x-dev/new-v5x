{
  "name": "code",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "bun run prepare:language && convex dev --start 'vite dev'",
    "typecheck": "tsc --noEmit",
    "build": "bun run prepare:language && bun run typecheck && vite build",
    "start": "node .output/server/index.mjs",
    "format": "prettier --write .",
    "lint": "bun run typecheck && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prepare:language": "bun ../../scripts/prepare-clangd.ts && bun ../../scripts/prepare-browser-compiler.ts && bun scripts/prepare-ez-pch.ts",
    "dev:ide": "bun run prepare:language && vite --config vite.ide.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clangd-wasm/core": "15.0.7",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "^1.4.3",
    "@pierre/storage": "^1.17.1",
    "@pierre/trees": "^1.0.0-beta.6",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.168.60",
    "@v5x/serial": "workspace:*",
    "better-auth": "~1.6.15",
    "boring-name-generator": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "microbit-clang-wasm": "21.11.0-alpha.1",
    "nitro": "^3.0.260903-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "smolmachines": "1.17.0",
    "tw-animate-css": "^1.4.0",
    "vscode-languageserver-protocol": "3.17.5",
    "vscode-snippet-parser": "0.0.5"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "convex-test": "^0.0.60",
    "eslint": "10.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
