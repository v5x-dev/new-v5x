{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "overrides": [
    {
      "files": ["src/hooks/use-mobile.ts", "src/components/theme-provider.tsx"],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    }
  ],
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "public/**",
    "node_modules/**",
    "dist/**",
    "dist-ssr/**",
    "coverage/**",
    ".nitro/**",
    ".tanstack/**",
    ".wrangler/**",
    ".output/**",
    ".vinxi/**"
  ]
}
