---
import { Icon } from "astro-icon/components"
import Base from "../layouts/Base.astro"
import "@fontsource-variable/roboto-slab"
---

<Base title="Sign in | v5x" description="Sign in to v5x.">
  <script is:inline slot="head">
    const raw = new URLSearchParams(location.search).get("returnTo")
    let theme = "site"
    try {
      const host = new URL(raw).hostname.toLowerCase()
      if (
        host === "code.v5x.dev" ||
        /^v5x-code-[a-z0-9-]+-qainguins-projects\.vercel\.app$/.test(host)
      ) {
        theme = "code"
      } else if (host === "brain.v5x.dev") theme = "brain"
      else if (host === "design.v5x.dev") theme = "design"
    } catch {}
    document.documentElement.dataset.login = theme
  </script>

  <div class="login-page grid h-screen w-screen place-items-center bg-background text-foreground">
    <div data-slot="card" data-size="default" class="group/card flex min-w-2xs flex-col gap-(--card-spacing) overflow-hidden rounded-xl bg-card py-(--card-spacing) text-sm text-card-foreground ring-1 ring-foreground/10 [--card-spacing:--spacing(4)]">
      <div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1 rounded-t-xl px-(--card-spacing)">
        <div data-slot="card-title" class="text-center text-base leading-snug font-medium">v5x</div>
      </div>
      <div role="separator" aria-orientation="horizontal" data-slot="separator" class="h-px w-full shrink-0 bg-border"></div>
      <div data-slot="card-content" class="flex flex-col gap-1 px-(--card-spacing)">
        <button id="google" type="button" data-slot="button" class="group/button inline-flex h-8 shrink-0 items-center justify-center gap-1.5 rounded-lg border border-transparent bg-primary bg-clip-padding px-2.5 text-sm font-medium whitespace-nowrap text-primary-foreground transition-all outline-none select-none hover:bg-primary/80 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:translate-y-px disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg]:size-4">
          <Icon name="ph:google-logo" />
          Sign in with Google
        </button>
        <span class="text-center text-muted-foreground">or</span>
        <button id="anonymous" type="button" data-slot="button" class="group/button inline-flex h-8 shrink-0 items-center justify-center gap-1.5 rounded-lg border border-border bg-background bg-clip-padding px-2.5 text-sm font-medium whitespace-nowrap transition-all outline-none select-none hover:bg-muted hover:text-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:translate-y-px disabled:pointer-events-none disabled:opacity-50 dark:border-input dark:bg-input/30 dark:hover:bg-input/50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg]:size-4">
          <Icon name="ph:detective" />
          Sign in anonymously
        </button>
        <p id="error" hidden role="alert" class="text-center text-sm text-destructive"></p>
      </div>
    </div>
  </div>
</Base>

<script>
  import { authServiceOrigin, loginTheme, safeReturnUrl } from "@v5x/auth"
  import { getSharedSession } from "@v5x/auth/browser"

  const fallback = `${location.origin}/`
  const destination = safeReturnUrl(
    new URLSearchParams(location.search).get("returnTo") ?? undefined,
    fallback,
  )

  document.documentElement.dataset.login = loginTheme(destination)

  const error = document.querySelector<HTMLElement>("#error")
  const buttons = [
    document.querySelector<HTMLButtonElement>("#google"),
    document.querySelector<HTMLButtonElement>("#anonymous"),
  ]

  function signInError(reason: unknown) {
    if (reason instanceof TypeError) return "Sign-in failed"
    if (reason instanceof Error && reason.message) return reason.message
    return "Sign-in failed"
  }

  function showError(message: string) {
    if (!error) return
    error.hidden = false
    error.textContent = message
  }

  function setBusy(busy: boolean) {
    for (const button of buttons) {
      if (button) button.disabled = busy
    }
  }

  async function postAuth(path: string, body: Record<string, unknown>) {
    const endpoint = new URL(path, authServiceOrigin(location.href))
    const response = await fetch(endpoint, {
      method: "POST",
      credentials: "include",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(body),
    })
    const payload = (await response.json().catch(() => null)) as {
      message?: string
      url?: string
    } | null
    if (!response.ok) throw new Error(payload?.message ?? "Sign-in failed")
    return payload
  }

  void getSharedSession().then((user) => {
    if (user && !user.isAnonymous) location.assign(destination)
  })

  document.querySelector("#google")?.addEventListener("click", () => {
    setBusy(true)
    void postAuth("/api/auth/sign-in/social", {
      provider: "google",
      callbackURL: destination,
      disableRedirect: true,
    })
      .then((payload) => {
        if (payload?.url) location.assign(payload.url)
        else {
          showError("Sign-in failed")
          setBusy(false)
        }
      })
      .catch((reason: unknown) => {
        showError(signInError(reason))
        setBusy(false)
      })
  })

  document.querySelector("#anonymous")?.addEventListener("click", () => {
    setBusy(true)
    void postAuth("/api/auth/sign-in/anonymous", {})
      .then(() => location.assign(destination))
      .catch((reason: unknown) => {
        showError(signInError(reason))
        setBusy(false)
      })
  })
</script>

<style is:global>
  html[data-login="code"] {
    --ring: oklch(0.714 0.014 41.2);
    --accent: oklch(0.96 0.002 17.2);
    --input: oklch(0.922 0.005 34.3);
    --background: oklch(1 0 0);
    --foreground: oklch(0.147 0.004 49.3);
    --card: oklch(1 0 0);
    --card-foreground: oklch(0.147 0.004 49.3);
    --primary: oklch(0.852 0.199 91.936);
    --primary-foreground: oklch(0.421 0.095 57.708);
    --secondary: oklch(0.967 0.001 286.375);
    --secondary-foreground: oklch(0.21 0.006 285.885);
    --muted: oklch(0.96 0.002 17.2);
    --muted-foreground: oklch(0.547 0.021 43.1);
    --border: oklch(0.922 0.005 34.3);
    --destructive: oklch(0.577 0.245 27.325);
    --chart-1: oklch(0.905 0.182 98.111);
