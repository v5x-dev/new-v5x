{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "convex/_generated/**",
    "src/routeTree.gen.ts",
    "public/**",
    "node_modules/**",
    "dist/**",
    ".nitro/**",
    ".tanstack/**",
    ".wrangler/**",
    ".output/**",
    ".vinxi/**",
    ".agents/**",
    ".claude/**",
    ".cursor/**",
    "docs/**"
  ]
}
