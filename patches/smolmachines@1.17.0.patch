+// Indirect so bundlers (Convex/esbuild) keep the native addon out of the
+// cloud bundle. Local loads still resolve the same files at runtime.
+function loadBinding(id) {
+  return require(id)
+}
+
+function findLocalBinding(prefix) {
+  const filename = readdirSync(__dirname).find((name) => name.startsWith(prefix))
+  return filename ? join(__dirname, filename) : null
+}
